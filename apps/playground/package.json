{
  "name": "playground",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "ios:release": "expo run:ios --configuration Release --device",
    "android:release": "expo run:android --variant release --device",
    "typecheck": "tsc --noEmit",
    "test": "echo \"no playground tests\"",
    "bundle-size": "node scripts/bundle-size.mjs",
    "make-car": "node scripts/make-car.mjs",
    "make-showroom": "node scripts/make-showroom.mjs",
    "prebuild": "expo prebuild --clean"
  },
  "dependencies": {
    "@apricotjs/assets": "workspace:*",
    "@apricotjs/core": "workspace:*",
    "@apricotjs/react-native": "workspace:*",
    "@typegpu/three": "0.12.1",
    "expo": "57.0.27",
    "expo-asset": "57.0.19",
    "expo-constants": "57.0.21",
    "expo-dev-client": "57.0.19",
    "expo-file-system": "57.0.7",
    "expo-linking": "57.0.12",
    "expo-router": "57.0.25",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.3",
    "react-native-webgpu": "0.12.1",
    "react-native-worklets": "0.10.1",
    "three": "0.186.1",
    "typegpu": "0.12.7"
  },
  "devDependencies": {
    "@apricotjs/metro": "workspace:*",
    "@types/react": "19.2.18",
    "@types/three": "0.186.0",
    "@webgpu/types": "0.1.74",
    "rolldown": "1.2.13",
    "typescript": "6.0.3",
    "unplugin-typegpu": "0.12.5"
  }
}
