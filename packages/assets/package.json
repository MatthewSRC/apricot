{
  "name": "@apricotjs/assets",
  "version": "0.1.0",
  "description": "Ready-made objects for the Apricot 3D engine: fruit, coins, cards, cars, trees and ground.",
  "license": "MIT",
  "homepage": "https://matthiasbrandolin.dev/apricot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatthewSRC/apricot.git",
    "directory": "packages/assets"
  },
  "bugs": "https://github.com/MatthewSRC/apricot/issues",
  "keywords": [
    "3d",
    "models",
    "react-native",
    "expo"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "!src/**/__tests__",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@apricotjs/core": "workspace:^",
    "@apricotjs/react-native": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "three": ">=0.186.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@webgpu/types": "0.1.74",
    "vitest": "^5.0.3",
    "three": "0.186.1",
    "@types/three": "0.186.0",
    "react-native-webgpu": "0.12.1",
    "react": "19.2.3",
    "@types/react": "19.2.18",
    "react-native": "0.86.3",
    "expo": "57.0.27",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "@testing-library/react": "^16.3.3",
    "react-dom": "19.2.3",
    "react-native-web": "0.21.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  }
}
